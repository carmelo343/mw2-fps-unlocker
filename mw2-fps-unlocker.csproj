<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>mw2_fps_unlocker</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>gnome-ico.ico</ApplicationIcon>
    <Authors>Branders</Authors>
    <Product>MW2 FPS Unlocker</Product>
    <StartupObject>mw2_fps_unlocker.Program</StartupObject>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MW2.FPS.Unlocker</AssemblyName>
    <EnableMemoryWrites Condition="'$(EnableMemoryWrites)' == ''">false</EnableMemoryWrites>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="gnome-ico.ico" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableMemoryWrites)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_MEMORY_WRITES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
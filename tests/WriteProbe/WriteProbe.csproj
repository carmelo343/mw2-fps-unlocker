<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ENABLE_MEMORY_WRITES</DefineConstants>
    <AssemblyName>MW2.Disposable.WriteProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/MemoryPolicy.cs" Link="MemoryPolicy.cs" />
    <Compile Include="../../Memory/MemoryHandler.cs" Link="MemoryHandler.cs" />
    <Compile Include="../../Diagnostics/DiagnosticLog.cs" Link="DiagnosticLog.cs" />
  </ItemGroup>
</Project>

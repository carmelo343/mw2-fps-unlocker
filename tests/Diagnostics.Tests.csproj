<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableMemoryWrites)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_MEMORY_WRITES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CrossoverRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);CROSSOVER_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CrossoverRelease)' == 'true'">
    <EmbeddedResource Include="../profiles/mw2-profile.json" LogicalName="mw2_fps_unlocker.mw2-profile.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="WriteProbe/**/*.cs" />
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Memory/MemoryHandler.cs" Link="MemoryHandler.cs" />
    <Compile Include="../Diagnostics/DiagnosticLog.cs" Link="DiagnosticLog.cs" />
  </ItemGroup>
</Project>
